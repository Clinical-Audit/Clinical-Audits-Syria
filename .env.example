# ---- Clinical Audit Syria — environment ----
# HTTP / HTTPS ports (behind nginx you only need PORT; nginx terminates TLS)
PORT=8080
HTTPS_PORT=8443

# Public origin (used for OAuth redirect + links). MUST match the domain users open.
PUBLIC_URL=https://clinicalaudit-syria.example.org

# Creator account (seeded on first run — change the password after first login)
CREATOR_EMAIL=you@example.com
CREATOR_PASSWORD=change-me-strong-password
CREATOR_NAME=Ahmed Al-Beiruti

# Signup invite code (the ONLY valid code)
INVITE_CODE=CA-XX-0000

# Google Drive — OAuth2 (primary, real account quota)
# Create an OAuth client of type "Web application", add the redirect URI
#   <PUBLIC_URL>/api/drive/oauth/callback
# then either paste the refresh token here, or use the in-app "ربط الحساب الآن".
GOOGLE_OAUTH_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-REPLACE_WITH_YOUR_SECRET
GOOGLE_OAUTH_REFRESH_TOKEN=
DRIVE_ROOT_NAME="التدقيق"
DRIVE_SHARE_WITH=you@example.com

# Service account (fallback; no storage quota — kept only as last resort)
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json

# Session / security
SESSION_TTL_HOURS=8
SESSION_IDLE_MINUTES=30

# Encrypted backups (AES-256-GCM). Keep this key safe & offline.
BACKUP_KEY_FILE=./backup.key
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=60

# TLS (only if you run HTTPS directly from Node instead of nginx)
# TLS_KEY=/etc/letsencrypt/live/clinicalaudit-syria.example.org/privkey.pem
# TLS_CERT=/etc/letsencrypt/live/clinicalaudit-syria.example.org/fullchain.pem
